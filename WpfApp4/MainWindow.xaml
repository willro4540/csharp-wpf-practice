<Window x:Class="WpfApp4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp4"
        xmlns:wpfmath="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        mc:Ignorable="d"
        Title="계산기"
        Height="534" Width="322"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- 01단계: 실제 윈도우 계산기 창 크기(322x534)에 맞춤. ResizeMode="NoResize"로
         사용자가 창 크기를 바꿔서 레이아웃이 깨지는 걸 막음 -->
    <Grid>
        <!-- 02단계: 4열 x 10행 그리드. 행마다 높이를 다르게 줘서
             맨 위(결과창)는 크게, 버튼 행들은 균등하게 배치 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <!-- 결과 표시줄 -->
            <RowDefinition Height="*"/>
            <!-- %, CE, C, ⌦ -->
            <RowDefinition Height="*"/>
            <!-- 1/x, x², √x, ÷ -->
            <RowDefinition Height="*"/>
            <!-- 7, 8, 9, × -->
            <RowDefinition Height="*"/>
            <!-- 4, 5, 6, − -->
            <RowDefinition Height="*"/>
            <!-- 1, 2, 3, + -->
            <RowDefinition Height="*"/>
            <!-- +/-, 0, ., = -->
        </Grid.RowDefinitions>

        <!-- 03단계: 결과 표시 Label. 4칸을 다 차지하도록 Grid.ColumnSpan=4,
             숫자는 오른쪽 정렬(HorizontalAlignment="Right")이 계산기 UI 관례 -->
        <Label x:Name="ResultLabel"
               Content="0"
               FontSize="46"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
               HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="10,0,10,0"/>

        <!-- 기능 버튼 행: %, CE, C, ⌦(지우기) -->
        <Button Content="%" Grid.Row="1" Grid.Column="0" Margin="1"/>
        <Button Content="CE" Grid.Row="1" Grid.Column="1" Margin="1"/>
        <Button Content="C" Grid.Row="1" Grid.Column="2" Margin="1"/>
        <!-- 04단계: ⌦(U+2326, Erase to the Right)는 일반 폰트에 없을 수 있어
             유니코드로 직접 지정. RenderTransform으로 필요하면 아이콘 방향을 미세조정 가능 -->
        <Button Content="&#x2326;" Grid.Row="1" Grid.Column="3" Margin="1">
            <Button.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Button.RenderTransform>
        </Button>

        <!-- 계산 버튼 행: 1/x, x², √x, ÷ -->
        <Button Content="1/x" Grid.Row="2" Grid.Column="0" Margin="1"/>
        <!-- 05단계: x², √x는 WpfMath의 FormulaControl로 실제 수학 기호처럼 렌더링 -->
        <Button Grid.Row="2" Grid.Column="1" Margin="1">
            <wpfmath:FormulaControl Formula="x^2" Scale="14"/>
        </Button>
        <Button Grid.Row="2" Grid.Column="2" Margin="1">
            <wpfmath:FormulaControl Formula="\sqrt{x}" Scale="14"/>
        </Button>
        <Button Content="&#xF7;" Grid.Row="2" Grid.Column="3" Margin="1"/>

        <!-- 숫자 패드: 7-9 -->
        <Button Content="7" Grid.Row="3" Grid.Column="0" Margin="1"/>
        <Button Content="8" Grid.Row="3" Grid.Column="1" Margin="1"/>
        <Button Content="9" Grid.Row="3" Grid.Column="2" Margin="1"/>
        <Button Content="&#xD7;" Grid.Row="3" Grid.Column="3" Margin="1"/>

        <!-- 숫자 패드: 4-6 -->
        <Button Content="4" Grid.Row="4" Grid.Column="0" Margin="1"/>
        <Button Content="5" Grid.Row="4" Grid.Column="1" Margin="1"/>
        <Button Content="6" Grid.Row="4" Grid.Column="2" Margin="1"/>
        <Button Content="&#x2212;" Grid.Row="4" Grid.Column="3" Margin="1"/>

        <!-- 숫자 패드: 1-3 -->
        <Button Content="1" Grid.Row="5" Grid.Column="0" Margin="1"/>
        <Button Content="2" Grid.Row="5" Grid.Column="1" Margin="1"/>
        <Button Content="3" Grid.Row="5" Grid.Column="2" Margin="1"/>
        <Button Content="+" Grid.Row="5" Grid.Column="3" Margin="1"/>

        <!-- 마지막 행: +/-, 0, ., = -->
        <Button Content="+/-" Grid.Row="6" Grid.Column="0" Margin="1"/>
        <Button Content="0" Grid.Row="6" Grid.Column="1" Margin="1"/>
        <Button Content="." Grid.Row="6" Grid.Column="2" Margin="1"/>
        <Button Content="="
                Background="{DynamicResource MenuHighlightBrushKey}"
                Foreground="#FFFFFFFF"
                Grid.Row="6" Grid.Column="3" Margin="1"/>
    </Grid>
</Window>
