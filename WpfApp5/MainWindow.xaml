<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="Panels 데모" Height="420" Width="640">
    <!-- 3.2 XAML-Panels 실습: 5개 Panel 종류를 탭으로 구분해 스크린샷 자료용으로 시각화 -->
    <TabControl>

        <!-- 1. Canvas: 절대좌표 배치 + Z-Index 겹침 순서 -->
        <TabItem Header="Canvas">
            <Canvas Background="White">
                <Ellipse Panel.ZIndex="1" Fill="Gainsboro" Canvas.Left="25" Canvas.Top="25"
                         Width="200" Height="200" />
                <Rectangle Panel.ZIndex="4" Fill="LightBlue" Canvas.Left="25" Canvas.Top="25"
                           Width="50" Height="50" />
                <Rectangle Panel.ZIndex="3" Fill="LightCoral" Canvas.Left="50" Canvas.Top="50"
                           Width="50" Height="50" />
                <Button Canvas.Left="10" Canvas.Top="10">Top left</Button>
                <Button Canvas.Right="10" Canvas.Top="10">Top right</Button>
                <Button Canvas.Left="10" Canvas.Bottom="10">Bottom left</Button>
                <Button Canvas.Right="10" Canvas.Bottom="10">Bottom right</Button>
            </Canvas>
        </TabItem>

        <!-- 2. WrapPanel: 공간 부족 시 자동 줄바꿈 -->
        <TabItem Header="WrapPanel">
            <WrapPanel Background="White" Margin="10">
                <Button Margin="4" Padding="10">Test button 1</Button>
                <Button Margin="4" Padding="10">Test button 2</Button>
                <Button Margin="4" Padding="10" Height="60">Test button 3 (키큼)</Button>
                <Button Margin="4" Padding="10">Test button 4</Button>
                <Button Margin="4" Padding="10">Test button 5</Button>
                <Button Margin="4" Padding="10">Test button 6</Button>
            </WrapPanel>
        </TabItem>

        <!-- 3. StackPanel: 한 방향으로만 쌓기 -->
        <TabItem Header="StackPanel">
            <StackPanel Background="White" Orientation="Horizontal" Margin="10">
                <Button Margin="4" Padding="10" VerticalAlignment="Top">Button 1 (Top)</Button>
                <Button Margin="4" Padding="10" VerticalAlignment="Center">Button 2 (Center)</Button>
                <Button Margin="4" Padding="10" VerticalAlignment="Bottom">Button 3 (Bottom)</Button>
            </StackPanel>
        </TabItem>

        <!-- 4. DockPanel: 상하좌우 도킹 + 마지막 요소가 중앙 자동 채움 -->
        <TabItem Header="DockPanel">
            <DockPanel Background="White">
                <Button DockPanel.Dock="Top" Height="40">Top</Button>
                <Button DockPanel.Dock="Bottom" Height="40">Bottom</Button>
                <Button DockPanel.Dock="Left" Width="80">Left</Button>
                <Button DockPanel.Dock="Right" Width="80">Right</Button>
                <Button>Center (LastChildFill)</Button>
            </DockPanel>
        </TabItem>

        <!-- 5. Grid: 행/열 분할 + Span(칸 확장) -->
        <TabItem Header="Grid">
            <Grid Background="White" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Margin="4">Button 1</Button>
                <Button Grid.Row="1" Grid.ColumnSpan="2" Margin="4">Button 2 (2열 확장)</Button>
                <Button Grid.Column="1" Grid.ColumnSpan="2" Margin="4">Button 3 (2열 확장)</Button>
                <Button Grid.Row="1" Grid.Column="2" Margin="4">Button 4</Button>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
