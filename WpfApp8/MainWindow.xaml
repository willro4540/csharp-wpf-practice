<Window x:Class="WpfApp8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp8"
        mc:Ignorable="d"
        Title="계산기"
        Icon="calculator_icon.ico"
        Height="480" Width="300"
        ResizeMode="NoResize">
    <!-- 3.5 XAML - Designer, Style 실습: 04단계(Title/Icon), 03단계(ColumnSpan
         크기조정), 05단계(색 변경)를 손으로 쓴 XAML로 재현.
         디자이너에서 마우스로 하는 걸 코드로 하면 이런 속성들이 바뀐다는 걸 보여줌 -->
    <Grid Background="#FF1A1A1A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="0" FontSize="46" Foreground="White"
                Grid.Row="0" Grid.ColumnSpan="4"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"/>

        <!-- 숫자 버튼: 어두운 회색 배경 + 흰 글씨 (Windows 계산기 다크 테마 흉내) -->
        <Button Content="7" Grid.Row="1" Grid.Column="0" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="8" Grid.Row="1" Grid.Column="1" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="9" Grid.Row="1" Grid.Column="2" Margin="2" Background="#FF333333" Foreground="White"/>
        <!-- 연산자 버튼: 살짝 밝은 회색으로 구분 -->
        <Button Content="÷" Grid.Row="1" Grid.Column="3" Margin="2" Background="#FF444444" Foreground="White"/>

        <Button Content="4" Grid.Row="2" Grid.Column="0" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="5" Grid.Row="2" Grid.Column="1" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="6" Grid.Row="2" Grid.Column="2" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="×" Grid.Row="2" Grid.Column="3" Margin="2" Background="#FF444444" Foreground="White"/>

        <Button Content="1" Grid.Row="3" Grid.Column="0" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="2" Grid.Row="3" Grid.Column="1" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="3" Grid.Row="3" Grid.Column="2" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="−" Grid.Row="3" Grid.Column="3" Margin="2" Background="#FF444444" Foreground="White"/>

        <!-- 03단계 "크기 조정" 재현: 원래 한 칸이던 0 버튼을 Grid.ColumnSpan="2"로
             넓혀서 실제 윈도우 계산기처럼 두 칸을 차지하게 만듦 -->
        <Button Content="0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="." Grid.Row="4" Grid.Column="2" Margin="2" Background="#FF333333" Foreground="White"/>
        <Button Content="+" Grid.Row="4" Grid.Column="3" Margin="2" Background="#FF444444" Foreground="White"/>

        <!-- 05단계 "색 변경": = 버튼만 강조색(파란색)으로 눈에 띄게 -->
        <Button Content="=" Grid.Row="5" Grid.ColumnSpan="4" Margin="2" Background="#FF0067C0" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>
